{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "ClipsX",
  "description": "User documentation for the ClipsX programmable desktop clipboard.",
  "logo": {
    "light": "/images/clipsx.svg",
    "dark": "/images/clipsx-light.svg",
    "href": "https://clipsx.app"
  },
  "favicon": "/images/clipsx.svg",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#7C3AED"
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "system"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "icon": "rocket",
        "pages": [
          "index",
          "getting-started",
          "platform-support"
        ]
      },
      {
        "group": "Use ClipsX",
        "icon": "clipboard",
        "pages": [
          "core-workflows",
          "local-ai",
          "extensions",
          "sync"
        ]
      },
      {
        "group": "Safety and support",
        "icon": "shield-check",
        "pages": [
          "privacy",
          "troubleshooting"
        ]
      },
      {
        "group": "Build extensions",
        "icon": "code-xml",
        "pages": [
          "developer-extensions"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://clipsx.app"
      },
      {
        "type": "github",
        "href": "https://github.com/azure06/clipsx"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Check downloads",
      "href": "https://clipsx.app/en/download"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/azure06/clipsx",
      "website": "https://clipsx.app"
    }
  },
  "search": {
    "prompt": "Search ClipsX documentation"
  },
  "contextual": {
    "options": ["copy", "chatgpt", "claude"],
    "display": "toc"
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.clipsx.app",
      "og:locale": "en_US"
    },
    "indexing": "navigable"
  },
  "redirects": [
    { "source": "/docs", "destination": "/", "permanent": true },
    { "source": "/docs/index", "destination": "/", "permanent": true },
    { "source": "/docs/getting-started", "destination": "/getting-started", "permanent": true },
    { "source": "/docs/platform-support", "destination": "/platform-support", "permanent": true },
    { "source": "/docs/core-workflows", "destination": "/core-workflows", "permanent": true },
    { "source": "/docs/local-ai", "destination": "/local-ai", "permanent": true },
    { "source": "/docs/meaning-search", "destination": "/local-ai", "permanent": true },
    { "source": "/docs/ollama", "destination": "/local-ai", "permanent": true },
    { "source": "/docs/extensions", "destination": "/extensions", "permanent": true },
    { "source": "/docs/developers", "destination": "/developer-extensions", "permanent": true },
    { "source": "/docs/sync", "destination": "/sync", "permanent": true },
    { "source": "/docs/privacy", "destination": "/privacy", "permanent": true },
    { "source": "/docs/troubleshooting", "destination": "/troubleshooting", "permanent": true }
  ]
}
