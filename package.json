{
  "name": "clipsx-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postbuild": "next-sitemap",
    "stripe:listen": "stripe listen --forward-to=localhost:3000/api/webhooks/stripe",
    "stripe:bootstrap-catalog": "node --env-file=.env.local scripts/bootstrap-stripe-catalog.mjs",
    "stripe:replay-pending": "node --env-file=.env.local scripts/replay-pending-stripe-events.mjs",
    "stripe:fixtures": "stripe fixtures fixtures/stripe-fixtures.json",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "supabase:generate-types": "supabase gen types typescript --linked > src/types/supabase.ts",
    "supabase:generate-types:local": "supabase gen types typescript --local > src/types/supabase.ts",
    "test:unit": "vitest run",
    "test:db": "supabase test db --db-url postgresql://postgres:postgres@127.0.0.1:54322/postgres supabase/tests",
    "test:backend": "npm run test:unit && npm run supabase:reset && npm run test:db && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@hpke/core": "1.9.0",
    "@hpke/dhkem-x25519": "1.8.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@scure/bip39": "2.2.0",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "cborg": "5.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.16.0",
    "next": "16.2.12",
    "next-intl": "^4.13.0",
    "next-sitemap": "^4.2.3",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.0",
    "server-only": "0.0.1",
    "stripe": "22.3.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "supabase": "2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
